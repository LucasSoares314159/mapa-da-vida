NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Valores exibidos por: npx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# AbacatePay Dev mode
ABACATEPAY_API_KEY=abc_dev_...
ABACATEPAY_PRODUCT_ID=prod_...
ABACATEPAY_WEBHOOK_SECRET=troque-por-um-segredo-forte
# Ative somente depois que CARD estiver liberado para a loja na AbacatePay.
ABACATEPAY_CARD_ENABLED=false
ACCESS_LINK_TTL_HOURS=168

# Mailpit incluido no Supabase local
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_FROM=MindTrail <noreply@mindtrail.local>

# Opcionais neste fluxo local
ADMIN_EMAILS=admin@example.com
CRON_SECRET=troque-este-valor

# Funil de quiz
NEXT_PUBLIC_QUIZ_ATIVO=true
CHECKOUT_PROVIDER=abacatepay
NEXT_PUBLIC_META_PIXEL_QUIZ_ID=
NEXT_PUBLIC_GA_ID=G-Z01PDPXHWB

# Conversions API da Meta (Purchase server-side)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Preencher so ao validar no Gerenciador de Eventos; remover depois, senao os
# eventos continuam chegando como teste e nao contam para a campanha.
META_CAPI_TEST_CODE=
